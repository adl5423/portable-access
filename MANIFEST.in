include LICENSE NOTICE THIRD_PARTY_NOTICES.md README.md SECURITY.md requirements*.lock
recursive-include docs *.md
recursive-include deploy *.py *.md *.json *.hcl *.service *.socket *.conf *.example *.sh
recursive-include tools *.py
recursive-include tests *.py
prune verification
prune node_modules
prune dist
prune build
recursive-include examples/docker-https *.py *.json *.md *.yaml *.yml Dockerfile* Caddyfile*
