[Unit]
Description=OpenBao isolated Transit signing service
Documentation=https://openbao.org/docs/
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=pap-kms
Group=pap-kms
ExecStart=/usr/local/bin/bao server -config=/etc/pap/openbao.hcl
ExecReload=/bin/kill -HUP $MAINPID
WorkingDirectory=/var/lib/pap-kms
StateDirectory=pap-kms
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/var/lib/pap-kms
InaccessiblePaths=/var/lib/pap-issuer /var/lib/pap-proxy /run/pap-admin
IPAddressDeny=any
IPAddressAllow=localhost
LimitNOFILE=8192
TasksMax=256
MemoryMax=2G
MemorySwapMax=0
LimitMEMLOCK=infinity
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pap-openbao

[Install]
WantedBy=multi-user.target
