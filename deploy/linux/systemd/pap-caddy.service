[Unit]
Description=Portable Access HTTPS gateway
Documentation=https://caddyserver.com/docs/
# Origin-control proof must be available before the authority and its KMS.
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=pap-proxy
Group=pap-proxy
ExecStart=/usr/bin/caddy run --config /etc/pap/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --address unix//var/lib/pap-proxy/admin.sock --config /etc/pap/Caddyfile --adapter caddyfile --force
WorkingDirectory=/var/lib/pap-proxy
StateDirectory=pap-proxy
StateDirectoryMode=0700
Environment=XDG_DATA_HOME=/var/lib/pap-proxy
Environment=XDG_CONFIG_HOME=/var/lib/pap-proxy
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/var/lib/pap-proxy
InaccessiblePaths=/var/lib/pap-issuer /var/lib/pap-kms /run/pap-admin
LimitNOFILE=65536
TasksMax=256
MemoryMax=1G
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pap-caddy

[Install]
WantedBy=multi-user.target
