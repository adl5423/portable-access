[Unit]
Description=Portable Access local certificate enrollment broker
Documentation=file:/opt/pap/source/deploy/linux/README.md
Before=pap-openbao.service pap-authority.service
After=time-sync.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=pap-enroller
Group=pap-kms
SupplementaryGroups=pap-issuer
ExecStart=/opt/pap/venv/bin/pap enrollment --config /etc/pap/enrollment.json
LoadCredential=enrollment-ca-key:/etc/pap/enrollment/ca-key.pem
WorkingDirectory=/var/lib/pap-enroller
StateDirectory=pap-enroller
StateDirectoryMode=0710
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/var/lib/pap-enroller /run/pap-enroller
InaccessiblePaths=/var/lib/pap-issuer /var/lib/pap-kms /var/lib/pap-proxy /run/pap-admin /etc/pap/enrollment
IPAddressDeny=any
LimitNOFILE=256
TasksMax=32
MemoryMax=256M
MemorySwapMax=0
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pap-enroller

[Install]
WantedBy=multi-user.target
